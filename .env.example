# ==========================================
# FastAPI Web Service Settings
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
HOST=0.0.0.0
PORT=8000

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# RabbitMQ Remote Broker Connection
# ==========================================
RABBITMQ_HOST=47.236.59.210
RABBITMQ_AMQP_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false
RABBITMQ_TIMEOUT_SECONDS=15

# ==========================================
# RabbitMQ Command Routing Configuration
# ==========================================
RABBITMQ_COMMAND_EXCHANGE=iot_commands
RABBITMQ_COMMAND_QUEUE=iot_exchange
RABBITMQ_COMMAND_ROUTING_KEY=iot.command
RABBITMQ_DEADLETTER_EXCHANGE=iot.deadletter
RABBITMQ_DEADLETTER_QUEUE=iot_exchange.deadletter
RABBITMQ_RESULT_EXCHANGE=iot_commands
RABBITMQ_RESULT_QUEUE=results
RABBITMQ_RESULT_ROUTING_KEY=results
