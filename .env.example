# ==========================================
# FastAPI Web Service Settings
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
HOST=0.0.0.0
PORT=8000

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=1024
GEMINI_REASONING_ENABLED=true
GEMINI_TEMPERATURE=0.2

# ==========================================
# Gemini Live & Zara Voice Configuration
# ==========================================
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_FALLBACK_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_INPUT_SAMPLE_RATE=16000
GEMINI_LIVE_OUTPUT_SAMPLE_RATE=24000
ZARA_LIVE_WS_TICKET_EXPIRE_SECONDS=120

# ==========================================
# Database Configuration (MySQL 8.4 / Local Async SQLite)
# ==========================================
# Default for zero-setup local development: SQLite async URL
DATABASE_URL=sqlite+aiosqlite:///data/sarah_platform.db

# Cloud-Hosted / Local MySQL 8.4 Credentials
# In WSL2, access Windows host MySQL via 192.168.112.1 (or localhost if using mirrored networking)
MYSQL_HOST=192.168.112.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sarah_db
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600

# ==========================================
# Security, Encryption & Multi-Tenant Identity
# ==========================================
APP_ENCRYPTION_KEY=sarah-secret-encryption-key-32b!
JWT_SECRET_KEY=sarah-jwt-secret-key-change-in-production-min32chars!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=rn-robots-sarah

# ==========================================
# RabbitMQ Remote Broker Connection
# ==========================================
RABBITMQ_HOST=47.236.59.210
RABBITMQ_AMQP_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false
RABBITMQ_TIMEOUT_SECONDS=15

# ==========================================
# RabbitMQ Command Routing Configuration
# ==========================================
RABBITMQ_COMMAND_EXCHANGE=iot_commands
RABBITMQ_COMMAND_QUEUE=iot_exchange
RABBITMQ_COMMAND_ROUTING_KEY=iot.command
RABBITMQ_DEADLETTER_EXCHANGE=iot.deadletter
RABBITMQ_DEADLETTER_QUEUE=iot_exchange.deadletter
RABBITMQ_RESULT_EXCHANGE=iot_commands
RABBITMQ_RESULT_QUEUE=results
RABBITMQ_RESULT_ROUTING_KEY=results

# ==========================================
# Device Registry Data Table Configuration
# ==========================================
DEVICES_DATA_FILE=data/devices.json

# ==========================================
# Speech-To-Text (STT) & Speech Processing
# ==========================================
STT_ENGINE=gemini
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
AUDIO_PREPROCESS_ENABLED=true
AUDIO_TARGET_PEAK=0.90
AUDIO_NOISE_REDUCTION_ENABLED=true
AUDIO_SILENCE_TRIM_ENABLED=true
