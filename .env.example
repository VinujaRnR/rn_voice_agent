# ==========================================
# FastAPI Web Service Settings
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
HOST=0.0.0.0
PORT=8000

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# RabbitMQ Remote Broker Connection
# ==========================================
RABBITMQ_URL=amqps://USER:PASSWORD@BROKER_HOST:5671/VHOST
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_AMQP_PORT=5672
RABBITMQ_USER=your-rabbitmq-user
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_USE_SSL=false
RABBITMQ_TIMEOUT_SECONDS=15

# ==========================================
# RabbitMQ Command Routing Configuration
# ==========================================
RABBITMQ_COMMAND_EXCHANGE=rn.hub
RABBITMQ_COMMAND_QUEUE=commands
RABBITMQ_COMMAND_ROUTING_KEY=commands
